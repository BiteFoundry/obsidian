  "optionalDependencies": {
    "@bitefoundry/obsidian-win32-x64": "0.2.3",
    "@bitefoundry/obsidian-win32-arm64": "0.2.3",
    "@bitefoundry/obsidian-darwin-x64": "0.2.3",
